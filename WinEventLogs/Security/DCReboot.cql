#repo = "3pi_windows_ad" (windows.EventID=1074)
| upper("windows.Computer", as=windows.Computer)
| upper("windows.EventData.SubjectUserName", as=windows.EventData.SubjectUserName)
| replace(".IKIGAI.COM", with="", field=windows.Computer, as="windows.Computer")
| parseTimestamp(field="windows.TimeCreated")
|formatTime(format="%d %B %Y, %H:%M:%S", as="PacificTime", timezone="America/Los_Angeles")
| regex("^(?<windows.EventData.param1>[^\\(]+)", field=windows.EventData.param1, strict=false)
| table([PacificTime, windows.Computer, windows.EventData.param7, windows.EventData.param1], limit=max)
| rename(field="windows.EventData.param7", as="RebootedBy")
| rename(field="windows.Computer", as="DC")
| rename(field="windows.EventData.param1", as="RebootSourceProcess")
