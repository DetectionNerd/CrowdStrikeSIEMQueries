#repo = microsoft_graphapi #event.dataset=azure.entraid.signin
| ioc:lookup(field=source.ip, type=ip_address, confidenceThreshold=unverified, strict=true, prefix=ipioc, include=[last_updated, malicious_confidence, labels, published_date, indicator, type])
|formatTime(format="%d %B %Y, %H:%M:%S", as="PacificTime", field=@timestamp, timezone="America/Los_Angeles")
| match(file="NetworkCIDRLookup1.csv", column="CIDR1", field=source.ip, mode=cidr, strict=false, include=["NetworkType1"]) | rename(field="NetworkType1", as="NetworkType")

| default(value="External", field="NetworkType")
| asn(field=source.ip, as=ip)
| rename(field="ip1.org", as="NetworkProvider")
| replace("Other.", with="--NA--", field="Vendor.status.failureReason", as="FailureReason")
| replace("azure.entraid.signin", with="Entra ID Signin", field="#event.dataset", as="EventType")
| default(value="No CrowdStrike intelligence available for this IP", field="ipioc[0].labels")
|formatTime(format="%d %B %Y, %H:%M:%S", as="IOCLastUpdatedIP", field="ipioc[0].last_updated", timezone="America/Los_Angeles")
|formatTime(format="%d %B %Y, %H:%M:%S", as="IOCPublishedIP", field="ipioc[0].published_date", timezone="America/Los_Angeles")
| ioc:lookup(field=user.domain, type=domain, confidenceThreshold=unverified, strict=false, prefix=domainioc, include=[last_updated, malicious_confidence, labels, published_date, indicator, type])
| default(value="No CrowdStrike intelligence available for this Domain", field="domainioc[0].labels")
|formatTime(format="%d %B %Y, %H:%M:%S", as="IOCLastUpdatedDomain", field="domainioc[0].last_updated", timezone="America/Los_Angeles")
|formatTime(format="%d %B %Y, %H:%M:%S", as="IOCPublishedDomain", field="domainioc[0].published_date", timezone="America/Los_Angeles")
| regex("(?<Vendor.UserName>[a-zA-Z0-9_-]+)\s*@", field=Vendor.userPrincipalName, strict=false)
| upper("Vendor.UserName", as=UserName)
| table([PacificTime, #event.outcome, UserName, Vendor.userPrincipalName, Vendor.deviceDetail.displayName, NetworkType, ipioc[0].indicator, NetworkProvider, ip.asn, ipioc.detected, IOCLastUpdatedIP, ipioc[0].malicious_confidence, ipioc[0].labels, IOCPublishedIP, Vendor.location.countryOrRegion, Vendor.location.state, Vendor.location.city, Vendor.appDisplayName, Vendor.resourceDisplayName, FailureReason, Vendor.status.additionalDetails, Vendor.status.errorCode, Vendor.riskState, Vendor.riskLevelDuringSignIn, Vendor.riskLevelAggregated, Vendor.riskDetail, user.domain, domainioc.detected, domainioc[0].indicator, IOCLastUpdatedDomain, domainioc[0].malicious_confidence, domainioc[0].labels, IOCPublishedDomain, Vendor.deviceDetail.operatingSystem, host.os.version, Vendor.deviceDetail.isManaged, Vendor.deviceDetail.trustType, Vendor.deviceDetail.isCompliant, Vendor.deviceDetail.browser, Vendor.conditionalAccessStatus, Vendor.clientAppUsed, Vendor.userDisplayName, Vendor.resourceId], limit=max)
| rename(field="Vendor.userPrincipalName", as="UserEmail")
| rename(field="#event.outcome", as="LoginResult")
| rename(field="Vendor.deviceDetail.displayName", as="DeviceName")
| rename(field="source.ip", as="SourceIP")
| rename(field="ip.asn", as="ASN")
| rename(field="Vendor.location.countryOrRegion", as="Country")
| rename(field="Vendor.location.state", as="State")
| rename(field="Vendor.location.city", as="City")
| rename(field="Vendor.appDisplayName", as="Application")
| rename(field="Vendor.resourceDisplayName", as="ResourceName")
| rename(field="Vendor.status.additionalDetails", as="ResultDetails")
| rename(field="Vendor.status.errorCode", as="ErrorCode")
| rename(field="Vendor.riskState", as="RiskState")
| rename(field="Vendor.riskLevelDuringSignIn", as="RiskLevel")
| rename(field="Vendor.riskLevelAggregated", as="RiskLevelAggregated")
| rename(field="Vendor.riskDetail", as="RiskDetail")
| rename(field="Vendor.deviceDetail.operatingSystem", as="DeviceOS")
| rename(field="host.os.version", as="OSv")
| rename(field="Vendor.deviceDetail.isManaged", as="DeviceType")
| rename(field="Vendor.deviceDetail.trustType", as="DeviceTrustType")
| rename(field="Vendor.deviceDetail.isCompliant", as="DeviceCompliantStatus")
| rename(field="Vendor.deviceDetail.browser", as="DeviceBrowser")
| rename(field="Vendor.conditionalAccessStatus", as="ConditionalAccessStatus")
| rename(field="Vendor.clientAppUsed", as="AppUsed")
| rename(field="Vendor.userDisplayName", as="UserFullName")
| rename(field="Vendor.resourceId", as="ResourceId")
| rename(field="user.domain", as="UserEmailDomain")
| rename(field="ipioc.detected", as="IOCDetectedIP")
| rename(field="ipioc[0].indicator", as="IOCIP")
| rename(field="ipioc[0].malicious_confidence", as="IOCConfidenceIP")
| rename(field="ipioc[0].labels", as="IOCLabelIP")

| rename(field="domainioc.detected", as="IOCDetectedDomain")
| rename(field="domainioc[0].indicator", as="IOCDomain")
| rename(field="domainioc[0].malicious_confidence", as="IOCConfidenceDomain")
| rename(field="domainioc[0].labels", as="IOCLabelDomain")
